# ---- Clerk ----
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_SIGN_IN_URL=/es/entrar
VITE_CLERK_SIGN_UP_URL=/es/empezar
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/es/mi-registro
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/es/mi-registro

# ---- Convex ----
VITE_CONVEX_URL=https://xxx.convex.cloud

# Set these in the Convex dashboard (npx convex env set), not here:
#   CLERK_JWT_ISSUER_DOMAIN   https://clerk.xuntas.org
#   CLERK_WEBHOOK_SECRET      whsec_xxx   (Clerk Dashboard > Webhooks)
#   RESEND_API_KEY            re_xxx
#   APP_URL                   https://app.xuntas.org

# Solo desarrollo: abre la ventana de registro antes del 4 de septiembre.
# NUNCA en producción — dejaría entrar registros fuera de la convocatoria.
VITE_VENTANA_SIEMPRE_ABIERTA=true
#   y del lado de Convex: npx convex env set VENTANA_SIEMPRE_ABIERTA true

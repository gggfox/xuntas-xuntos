# Copy to .env.local. Development only.
#
# The shared dev values (Clerk test keys, VITE_WINDOW_ALWAYS_OPEN) live in
# Infisical, project xuntas-xuntos, environment `dev`. `npm run dev:secrets`
# injects them, so with Infisical you only need the two per-developer lines
# below: CONVEX_DEPLOYMENT (written by `npx convex dev`) and VITE_CONVEX_URL.
# Without Infisical, fill everything in here by hand as before.
#
# Staging and production never read this file: the container build fetches
# its values from Infisical (see docs/DEPLOYMENT.md).

# ---- Clerk ----
# VITE_* variables are embedded into the client bundle during the build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# No VITE_ prefix: the Clerk middleware reads these during SSR, at runtime.
# In production they go in as container environment variables, NOT as build
# args. If they are missing, every route responds 500.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

VITE_CLERK_SIGN_IN_URL=/es/entrar
VITE_CLERK_SIGN_UP_URL=/es/empezar
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/es/mi-registro
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/es/mi-registro

# ---- Convex ----
VITE_CONVEX_URL=https://xxx.convex.cloud

# These go in the Convex deployment (npx convex env set), not here:
#   CLERK_JWT_ISSUER_DOMAIN   https://<slug>.clerk.accounts.dev
#   CLERK_WEBHOOK_SECRET      whsec_xxx   (Clerk Dashboard > Webhooks)
#   RESEND_API_KEY            re_xxx
#   RESEND_WEBHOOK_SECRET     whsec_xxx
#   APP_URL                   http://localhost:3000
#   RESEND_TEST_MODE          leave it unset in dev: that way Resend only
#                             accepts @resend.dev and no real person gets mail
#
# CAREFUL: `npx convex env set` writes to DEVELOPMENT. Production takes --prod,
# staging takes --deployment staging.

# Development only: opens the registration window before September 4.
# NEVER in production — it would let registrations in outside the call period.
VITE_WINDOW_ALWAYS_OPEN=true
#   and on the Convex side: npx convex env set WINDOW_ALWAYS_OPEN true

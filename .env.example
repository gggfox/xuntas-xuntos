# Copia a .env.local. Solo desarrollo — producción se configura en Dokploy y en
# Convex, ver docs/DESPLIEGUE.md.

# ---- Clerk ----
# VITE_* se incrustan en el bundle del cliente durante el build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Sin prefijo VITE_: las lee el middleware de Clerk en el SSR, en tiempo de
# ejecución. En producción van como variables de entorno del contenedor, NO
# como build args. Si faltan, todas las rutas contestan 500.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

VITE_CLERK_SIGN_IN_URL=/es/entrar
VITE_CLERK_SIGN_UP_URL=/es/empezar
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/es/mi-registro
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/es/mi-registro

# ---- Convex ----
VITE_CONVEX_URL=https://xxx.convex.cloud

# Estas van en el deployment de Convex (npx convex env set), no aquí:
#   CLERK_JWT_ISSUER_DOMAIN   https://<slug>.clerk.accounts.dev
#   CLERK_WEBHOOK_SECRET      whsec_xxx   (Clerk Dashboard > Webhooks)
#   RESEND_API_KEY            re_xxx
#   RESEND_WEBHOOK_SECRET     whsec_xxx
#   APP_URL                   http://localhost:3000
#   RESEND_TEST_MODE          déjala sin definir en dev: así Resend solo acepta
#                             @resend.dev y no le llega correo a nadie de verdad
#
# OJO: `npx convex env set` escribe en DESARROLLO. Producción lleva --prod.

# Solo desarrollo: abre la ventana de registro antes del 4 de septiembre.
# NUNCA en producción — dejaría entrar registros fuera de la convocatoria.
VITE_VENTANA_SIEMPRE_ABIERTA=true
#   y del lado de Convex: npx convex env set VENTANA_SIEMPRE_ABIERTA true

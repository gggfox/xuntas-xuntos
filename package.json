    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/localizations": "^4.15.7",
    "@clerk/tanstack-react-start": "^1.5.8",
    "@convex-dev/resend": "^0.2.7",

{
  "name": "xuntas-xuntos",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run test",
    "deploy:convex": "convex deploy",
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
